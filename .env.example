# Copy real Development values from Neon/Vercel into .env.local.
# Vercel Preview/Production secrets cannot be pulled; [SENSITIVE] is not a URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-NEON-AUTH-HOST/DATABASE/auth
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use the same secret on all instances in the same deployment environment.
NEON_AUTH_COOKIE_SECRET=
